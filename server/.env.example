# ---- Application ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=true                  # false = human-readable logs for local dev
# Demo-only self-service role switch (POST /users/me/role). Set false in prod.
ALLOW_SELF_ROLE_CHANGE=true

# ---- Database ----
# Either provide a full DB_URL, or DB_URL (host/db only) + DB_USERNAME/DB_PASSWORD.
# The app rewrites the scheme to postgresql+asyncpg:// for the async engine.
DB_URL=postgresql://localhost:5432/kevin
DB_USERNAME=kevin
DB_PASSWORD=admin123

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# Token verification mode: "dev" (accept locally-minted tokens; blocked in prod)
# or "google" (verify real Google ID tokens; requires GOOGLE_OAUTH_CLIENT_IDS).
AUTH_MODE=dev
# Google OAuth client IDs allowed to issue ID tokens. Set these when AUTH_MODE=google.
# Either a comma-separated list here...
GOOGLE_OAUTH_CLIENT_IDS=
# ...or the individual client IDs from the Google Cloud console (merged with the
# list above). The mobile (Android) and web client IDs both become accepted
# token audiences. WEB_CLIENT_SECRET is only needed for a server-side auth-code
# exchange, not for ID-token verification.
MOBILE_CLIENT_ID=
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=

# ---- Redis (broker + rate limiting / idempotency) ----
REDIS_URL=redis://localhost:6379/0

# ---- Storage ----
# "gcs" (Google Cloud Storage) or "memory" (in-process, for local dev/tests).
STORAGE_BACKEND=gcs
SIGNED_URL_TTL_SECONDS=900

# ---- Google Cloud ----
GCP_PROJECT_ID=packingandmoving
GCS_BUCKET_NAME=inventory_pictures
GOOGLE_APPLICATION_CREDENTIALS=packingandmoving-343bc5089528.json

# ---- AI ----
# gemini (default) or stub (deterministic canned analysis; no API calls).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_IMAGES=30
AI_MAX_ITEMS=200
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# ---- Rate limiting (in-process sliding window) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=20

# ---- Upload limits ----
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=30
